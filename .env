# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=4e0a3159cd111ff3a9ce71192597e47e7ebc13e44d2d8fc454983c3160691f8b

# Admin credentials (only used to seed DB on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=oineshh

# ── Optional ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=0

# Storage paths (defaults are relative to project root)
DATABASE_PATH=data/pdf_system.db
UPLOAD_FOLDER=storage/uploads
TEMP_UPLOAD_FOLDER=storage/temp
PDF_CACHE_FOLDER=storage/cache

# 32 MB
MAX_UPLOAD_BYTES=33554432

TEMP_FILE_LIFETIME_HOURS=14

# Redis (optional — app uses thread fallback if not set)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_JSON=1

# Session
SESSION_COOKIE_SECURE=1
SESSION_LIFETIME_SECONDS=1800

# Server
HOST=0.0.0.0
PORT=8000
